---
import LayerTag from './LayerTag.astro';
import { formatDate, postUrl, readingMinutes, type Post } from '../lib/site';

interface Props {
  posts: Post[];
  /** 'full' shows the description; 'compact' is one line per post. */
  variant?: 'full' | 'compact';
  showLayer?: boolean;
  empty?: string;
}
const { posts, variant = 'full', showLayer = true, empty = 'Nothing here yet.' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ol class:list={['posts', variant]}>
      {posts.map((post) => (
        <li>
          <article>
            <h3>
              <a href={postUrl(post)}>{post.data.title}</a>
              {post.data.draft && <span class="draft-flag">Draft</span>}
            </h3>
            {variant === 'full' && <p class="desc">{post.data.description}</p>}
            <div class="meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {showLayer && <LayerTag layer={post.data.layer} />}
              {variant === 'full' && <span>{readingMinutes(post.body)} min read</span>}
            </div>
          </article>
        </li>
      ))}
    </ol>
  )
}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts > li {
    border-top: 1px solid var(--rule);
  }
  .posts > li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  article {
    padding-block: 1.15rem;
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 650;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-faint);
  }
  .desc {
    margin: 0.4rem 0 0.55rem;
    font-family: var(--font-body);
    color: var(--ink-soft);
  }
  .compact article {
    padding-block: 0.8rem;
  }
  .compact h3 {
    font-size: var(--step-0);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .empty {
    color: var(--ink-soft);
    font-family: var(--font-body);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
</style>
