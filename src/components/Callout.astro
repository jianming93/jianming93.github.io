---
// Use in .mdx logs:
//   import Callout from '../../components/Callout.astro';
//   <Callout kind="gotcha" title="Watch out">...</Callout>
interface Props {
  kind?: 'note' | 'gotcha' | 'aside';
  title?: string;
}
const { kind = 'note', title } = Astro.props;
const defaults = { note: 'Note', gotcha: 'Gotcha', aside: 'Aside' };
---

<aside class:list={['callout', kind]}>
  <p class="title">{title ?? defaults[kind]}</p>
  <div class="content"><slot /></div>
</aside>

<style>
  .callout {
    --cc: var(--link);
    font-family: var(--font-ui);
    font-size: 0.97rem;
    line-height: 1.55;
    background: color-mix(in srgb, var(--cc) 7%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--cc) 25%, transparent);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
  }
  .gotcha {
    --cc: var(--layer-kernels);
  }
  .aside {
    --cc: var(--ink-faint);
  }
  .title {
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: var(--cc);
  }
  .content :global(> :first-child) {
    margin-top: 0;
  }
  .content :global(> :last-child) {
    margin-bottom: 0;
  }
  .content :global(p) {
    margin: 0.5em 0;
  }
</style>
