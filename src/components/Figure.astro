---
// A captioned image for MDX. Import the image so Astro can optimise it:
//
//   import shell from '../../assets/projects/incremental-learner/shell-theory.png';
//   <Figure src={shell} alt="Shell theory" caption="Concept of shell in high dimensions" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Maximum width as a CSS length. */
  width?: string;
}
const { src, alt, caption, width = '70%' } = Astro.props;
---

<figure style={`max-width:${width}`}>
  <Image src={src} alt={alt} widths={[480, 720, 1080]} sizes="(min-width: 760px) 720px, 100vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin-inline: auto;
    text-align: center;
  }
  img {
    max-width: 100%;
    height: auto;
  }
</style>
