---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LayerTag from '../../components/LayerTag.astro';
import { getLayer } from '../../data/layers';
import { codeUrl, formatDate, getPosts, getSeries, postUrl, readingMinutes, url, AUTHOR, GITHUB_URL, LINKEDIN_URL, REPO_URL, type Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // posts are newest first; "older" is the next item in the list.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, layer, code, series, part, draft } = post.data;
const layerInfo = getLayer(layer);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.filter((h) => h.depth === 2).length >= 3;

// "Suggest an edit" link straight to this file on GitHub.
const editUrl = post.filePath ? `${REPO_URL}/edit/main/${post.filePath}` : undefined;

// Other parts of the same series, if this post belongs to one.
const seriesPosts = series ? await getSeries(series) : [];
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id);
---

<BaseLayout title={title} description={description} type="article">
  <div class="wrap">
    <article class:list={['post', { 'has-toc': showToc }]} style={`--c:${layerInfo.color}`}>
      <header class="post-head">
        <div class="kicker">
          <LayerTag layer={layer} />
          {draft && <span class="draft-flag">Draft, not published</span>}
        </div>
        <h1>{title}</h1>
        <p class="dek">{description}</p>
        <div class="meta">
          <span>By <a href={url('/')}>{AUTHOR}</a></span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
          <span>{readingMinutes(post.body)} min read</span>
          {code && <a href={codeUrl(code)}>Code for this post</a>}
        </div>
      </header>

      {
        showToc && (
          <nav class="toc" aria-label="On this page">
            <details open>
              <summary>On this page</summary>
              <ol>
                {toc.map((h) => (
                  <li class={`d${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }

      <div class="prose body">
        {
          seriesPosts.length > 1 && (
            <nav class="series" aria-label="Series">
              <p class="series-title">
                {series}
                {part && <span>Part {part} of {seriesPosts.length}</span>}
              </p>
              <ol>
                {seriesPosts.map((p, i) => (
                  <li aria-current={i === seriesIndex ? 'page' : undefined}>
                    {i === seriesIndex ? p.data.title : <a href={postUrl(p)}>{p.data.title}</a>}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <Content />
      </div>

      <footer class="post-foot">
        <aside class="author" aria-label="About the author">
          <p class="author-name"><a href={url('/')}>{AUTHOR}</a></p>
          <p>AI engineer, learning the LLM stack in public, from algorithms down to GPU kernels and serving.</p>
          <p class="author-links">
            <a href={url('/about/')}>About</a>
            <a href={GITHUB_URL}>GitHub</a>
            <a href={LINKEDIN_URL}>LinkedIn</a>
            <a href={url('/rss.xml')}>RSS</a>
          </p>
        </aside>
        <p class="fix">
          Spotted a mistake? I'm learning as I go, so corrections are very welcome.
          {editUrl && <a href={editUrl}>Suggest an edit on GitHub</a>}
        </p>
        <nav class="pager" aria-label="More posts">
          {
            older ? (
              <a class="older" href={postUrl(older)}>
                <span>Older</span>
                {older.data.title}
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="newer" href={postUrl(newer)}>
                <span>Newer</span>
                {newer.data.title}
              </a>
            )
          }
        </nav>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  // On narrow screens the contents list sits above the post, so start it collapsed.
  if (matchMedia('(max-width: 1000px)').matches) {
    document.querySelector('.toc details')?.removeAttribute('open');
  }
</script>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 3.5rem;
    border-left: 4px solid var(--c);
    padding-left: clamp(1rem, 3vw, 2.25rem);
  }
  .post.has-toc {
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 15rem);
    grid-template-areas:
      'head head'
      'body toc'
      'foot .';
  }
  .has-toc .post-head { grid-area: head; }
  /* Full width: the Markdown body is not capped at the reading measure. */
  .body { max-width: none; }
  .has-toc .body { grid-area: body; }
  .has-toc .toc { grid-area: toc; }
  .has-toc .post-foot { grid-area: foot; }

  .post-head {
    margin-bottom: 2.5rem;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }
  .dek {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0.9rem 0 1rem;
  }

  .toc {
    align-self: start;
    position: sticky;
    top: 1.5rem;
    font-size: 0.9rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
  }
  .toc summary {
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 0.5rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--rule);
    display: grid;
    gap: 0.4rem;
  }
  .toc .d3 {
    padding-left: 0.9rem;
    font-size: 0.85rem;
  }
  .toc a {
    color: var(--ink-soft);
    text-decoration: none;
    line-height: 1.3;
    display: block;
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .series {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--c);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
    margin-bottom: 2rem;
  }
  .series-title {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }
  .series-title span {
    font-weight: 500;
    color: var(--ink-faint);
  }
  .series ol {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 0.2rem;
  }
  .series li[aria-current='page'] {
    font-weight: 600;
  }

  .post-foot {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .author {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }
  .author p {
    margin: 0;
    color: var(--ink-soft);
  }
  .author .author-name {
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }
  .author .author-name a {
    color: var(--ink);
    text-decoration: none;
  }
  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.5rem !important;
  }
  .fix {
    font-family: var(--font-body);
    color: var(--ink-soft);
    margin: 0 0 2rem;
  }
  .fix a {
    margin-left: 0.25rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .pager a {
    display: grid;
    gap: 0.2rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
  }
  .pager a span {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-faint);
  }
  .pager a:hover {
    text-decoration: underline;
  }
  .pager .newer {
    text-align: right;
  }

  @media (max-width: 1000px) {
    .post.has-toc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'toc' 'body' 'foot';
    }
    .toc {
      position: static;
      max-height: none;
      margin-bottom: 2rem;
      padding: 0.9rem 1rem;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }
  }
  @media (max-width: 640px) {
    .post {
      border-left-width: 3px;
      padding-left: 0.9rem;
    }
  }
</style>
