---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getProjects, url } from '../../lib/site';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Personal and academic projects: LLM serving, incremental learning and a GPT-3 CSV query app.">
  <div class="wrap">
    <PageHeader title="Projects" lede="Things I've built, with write-ups of how they work." />
    <ul class="cards">
      {
        projects.map((p) => (
          <li>
            <a class="card-project" href={url(`/projects/${p.id}/`)}>
              {p.data.cover && <Image class="cover" src={p.data.cover} alt="" widths={[360, 720]} sizes="(min-width: 700px) 340px, 90vw" />}
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              {p.data.tags.length > 0 && (
                <ul class="tags" aria-label="Technologies">
                  {p.data.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .card-project {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.1rem 1.25rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) - 2px);
  }
  .tags {
    list-style: none;
    margin: auto 0 0;
    padding: 0.4rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tags li {
    padding: 0.05rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card-project:hover {
    border-color: var(--ink-faint);
  }
  h2 {
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.25;
  }
  p {
    margin: 0;
    font-family: var(--font-body);
    color: var(--ink-soft);
    line-height: 1.45;
  }
</style>
